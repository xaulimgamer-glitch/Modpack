{
  "type": "origins:action_over_time",
  "interval": 120,

  "entity_action": {
    "type": "origins:change_resource",
    "resource": "rpgraces:frogfolk/moisture",
    "change": -1
  },

  "condition": {
    "type": "origins:and",
    "conditions": [
      {
        "type": "origins:fluid_height",
        "fluid": "minecraft:water",
        "comparison": "==",
        "compare_to": 0.0
      },
      {
        "type": "origins:in_rain",
        "inverted": true
      },
      {
        "type": "origins:biome",
        "condition": {
          "type": "origins:temperature",
          "comparison": ">=",
          "compare_to": 2.0
        },
        "inverted": true
      },
      {
        "type": "origins:biome",
        "condition": {
          "type": "origins:high_humidity"
        },
        "inverted": true
      }
    ]
  },

  "hidden": true
}