{
  "type": "origins:active_self",
  "name": "Unfurl",
  "description": "Grow one stage: Compact → Natural → Bloomed. Natural form grants 15% attack speed; Bloomed form grows to 140% scale, grants 2 armor and 30% knockback resistance, but reduces movement speed by 10%.",
  "cooldown": 10,

  "hud_render": {
    "should_render": false
  },

  "key": {
    "key": "key.origins.primary_active"
  },

  "entity_action": {
    "type": "origins:if_else_list",
    "actions": [
      {
        "condition": {
          "type": "origins:resource",
          "resource": "rpgraces:myconid/form_state",
          "comparison": "==",
          "compare_to": 0
        },
        "action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:change_resource",
              "resource": "rpgraces:myconid/form_state",
              "operation": "set",
              "change": 1
            },
            {
              "type": "origins:execute_command",
              "command": "function rpgraces:myconid/natural"
            }
          ]
        }
      },
      {
        "condition": {
          "type": "origins:resource",
          "resource": "rpgraces:myconid/form_state",
          "comparison": "==",
          "compare_to": 1
        },
        "action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:change_resource",
              "resource": "rpgraces:myconid/form_state",
              "operation": "set",
              "change": 2
            },
            {
              "type": "origins:execute_command",
              "command": "function rpgraces:myconid/bloomed"
            }
          ]
        }
      }
    ]
  }
}