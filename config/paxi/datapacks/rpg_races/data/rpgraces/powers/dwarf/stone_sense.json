{
  "type": "origins:multiple",
  "name": "Stone Sense",
  "description": "While standing on stone, use your Secondary Active ability to sense grounded living creatures within 10 blocks through walls for 5 seconds. 45-second cooldown.",

  "active": {
    "type": "origins:resource",
    "min": 0,
    "max": 100,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },

  "activate": {
    "type": "origins:active_self",
    "cooldown": 900,
    "hud_render": {
      "should_render": false
    },
    "key": {
      "key": "key.origins.secondary_active"
    },
    "condition": {
      "type": "origins:on_block",
      "block_condition": {
        "type": "origins:in_tag",
        "tag": "apoli:material/stone"
      }
    },
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "rpgraces:dwarf/stone_sense_active",
      "operation": "set",
      "change": 100
    }
  },

  "decay": {
    "type": "origins:action_over_time",
    "interval": 1,
    "condition": {
      "type": "origins:resource",
      "resource": "rpgraces:dwarf/stone_sense_active",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_action": {
      "type": "origins:change_resource",
      "resource": "rpgraces:dwarf/stone_sense_active",
      "change": -1
    }
  },

  "sense": {
    "type": "origins:entity_glow",
    "use_teams": false,
    "red": 0.80,
    "green": 0.68,
    "blue": 0.42,
    "condition": {
      "type": "origins:resource",
      "resource": "rpgraces:dwarf/stone_sense_active",
      "comparison": ">",
      "compare_to": 0
    },
    "entity_condition": {
      "type": "origins:and",
      "conditions": [
        {
          "type": "origins:living"
        },
        {
          "type": "origins:on_block"
        }
      ]
    },
    "bientity_condition": {
      "type": "origins:distance",
      "comparison": "<=",
      "compare_to": 10.0
    }
  }
}
