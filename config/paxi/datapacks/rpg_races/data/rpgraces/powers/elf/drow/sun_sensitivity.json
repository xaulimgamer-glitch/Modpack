{
  "type": "apoli:multiple",
  "name": "Sun Sensitivity",
  "description": "Your eyes are adapted to darkness. Direct sunlight always impairs your vision and performance, especially after leaving deep darkness; after a few seconds, your eyes partially adjust, but the solar penalty remains.",
  "dark_adaptation": {
    "type": "apoli:resource",
    "min": 0,
    "max": 100,
    "start_value": 0,
    "hud_render": {
      "should_render": false
    }
  },
  "adapt_to_dark": {
    "type": "apoli:action_over_time",
    "interval": 5,
    "condition": {
      "type": "origins:brightness",
      "comparison": "<=",
      "compare_to": 0.2
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "rpgraces:elf/drow/sun_sensitivity_dark_adaptation",
      "change": 1
    }
  },
  "adapt_to_sun": {
    "type": "apoli:action_over_time",
    "interval": 5,
    "condition": {
      "type": "origins:exposed_to_sun"
    },
    "entity_action": {
      "type": "apoli:change_resource",
      "resource": "rpgraces:elf/drow/sun_sensitivity_dark_adaptation",
      "change": -3
    }
  },
  "base_attack_penalty": {
    "type": "apoli:conditioned_attribute",
    "condition": {
      "type": "origins:exposed_to_sun"
    },
    "modifier": {
      "name": "Drow Base Sun Sensitivity",
      "attribute": "minecraft:generic.attack_speed",
      "operation": "multiply_base",
      "value": -0.1
    },
    "tick_rate": 5
  },
  "base_mining_penalty": {
    "type": "apoli:modify_break_speed",
    "condition": {
      "type": "origins:exposed_to_sun"
    },
    "modifier": {
      "operation": "multiply_total",
      "value": -0.1
    }
  },
