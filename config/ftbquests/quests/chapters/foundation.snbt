			y: -2.5d
		}
		{
			dependencies: ["02BBD3B3F85549B1"]
			description: [
				"&lFirst Forging&r"
				""
				"You have the metal. You have the tools. Now learn the craft."
				""
				"Heat your &lCopper&r until it is ready to be worked, then use your &lSmithing Tongs&r to handle it safely and bring it to the &lAnvil&r."
				""
				"Unlike ordinary crafting, forged equipment is made through a process. The metal must be heated, positioned, and worked into shape rather than assembled instantly on a crafting table."
				""
				"The way an item is forged can affect its &lQuality&r. You do not need to master that yet — for now, focus on learning the basic process and producing something useful."
				""
				"&lHeat the Copper. Grip it with your Tongs. Work it at the Anvil. Forge your first Copper item.&r"
			]
			icon: {
				Count: 1
				id: "overgeared:copper_pickaxe"
				tag: {
					Damage: 0
				}
			}
